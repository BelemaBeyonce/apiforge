  "components": {
    "schemas": {
      "Criterion": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Name"
          },
          "kind": {
            "type": "string",
            "enum": [
              "exact",
              "contains"
            ],
            "title": "Kind"
          },
          "reference": {
            "type": "string",
            "maxLength": 10000,
            "minLength": 1,
            "title": "Reference"
          },
          "weight": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Weight",
            "default": 1
          },
          "case_sensitive": {
            "type": "boolean",
            "title": "Case Sensitive",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "kind",
          "reference"
        ],
        "title": "Criterion"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "details": {
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "type": "array",
            "title": "Details"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message",
          "details",
          "request_id"
        ],
        "title": "ErrorBody"
      },
      "ErrorDetail": {
        "properties": {
          "location": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Type"
          }
        },
        "type": "object",
        "required": [
          "location",
          "message",
          "type"
        ],
        "title": "ErrorDetail"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "EvaluationPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/EvaluationRead"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "limit": {
            "type": "integer",
            "title": "Limit"
          },
          "offset": {
            "type": "integer",
            "title": "Offset"
          }
        },
        "type": "object",
        "required": [
          "items",
          "total",
          "limit",
          "offset"
        ],
        "title": "EvaluationPage"
      },
      "EvaluationRead": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "task_id": {
            "type": "integer",
            "title": "Task Id"
          },
          "response": {
            "type": "string",
            "title": "Response"
          },
          "score": {
            "type": "number",
            "title": "Score"
          },
          "feedback": {
            "items": {
              "$ref": "#/components/schemas/Feedback"
            },
            "type": "array",
            "title": "Feedback"
          },
          "task_snapshot": {
            "additionalProperties": true,
            "type": "object",
            "title": "Task Snapshot"
          },
          "engine_version": {
            "type": "string",
            "title": "Engine Version"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "task_id",
          "response",
          "score",
          "feedback",
          "task_snapshot",
          "engine_version",
          "created_at"
        ],
        "title": "EvaluationRead"
      },
      "Feedback": {
        "properties": {
          "criterion": {
            "type": "string",
            "title": "Criterion"
          },
          "passed": {
            "type": "boolean",
            "title": "Passed"
          },
          "earned_weight": {
            "type": "integer",
            "title": "Earned Weight"
          },
          "possible_weight": {
            "type": "integer",
            "title": "Possible Weight"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "criterion",
          "passed",
          "earned_weight",
          "possible_weight",
          "message"
        ],
        "title": "Feedback"
      },
      "Submission": {
        "properties": {
          "response": {
            "type": "string",
            "maxLength": 50000,
            "minLength": 1,
            "title": "Response"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "response"
        ],
        "title": "Submission"
      },
      "TaskInput": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Title"
          },
          "description": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 1,
            "title": "Description"
          },
          "language": {
            "type": "string",
            "maxLength": 40,
            "minLength": 1,
            "pattern": "^[a-z0-9+#.-]+$",
            "title": "Language"
          },
          "difficulty": {
            "type": "string",
            "enum": [
              "easy",
              "medium",
              "hard"
            ],
            "title": "Difficulty"
          },
          "expected_outcome": {
            "type": "string",
