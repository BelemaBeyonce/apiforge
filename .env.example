ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./apiforge.db
# Generate your own stable key; required in production and by Docker Compose.
# JWT_SECRET=replace-with-at-least-32-random-characters
TOKEN_MINUTES=30
CORS_ORIGINS=[]
AUTH_RATE_LIMIT=10
MAX_REQUEST_BYTES=262144
AI_ENABLED=false
AI_ALLOW_EXTERNAL=false
AI_PROVIDER=openai
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=15
AI_RETRIES=1
# AI_API_KEY=your-own-key-only-if-explicitly-enabling-external-AI
POSTGRES_USER=apiforge
POSTGRES_DB=apiforge
POSTGRES_PASSWORD=
# POSTGRES_DATABASE_URL=postgresql+psycopg://apiforge@postgres:5432/apiforge
POSTGRES_API_PORT=8001
