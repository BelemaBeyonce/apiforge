ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./apiforge.db
# PostgreSQL: set your own credentials in the environment, URL-encode special characters.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/apiforge
# Docker Compose PostgreSQL profile requires POSTGRES_PASSWORD to be set.
POSTGRES_USER=apiforge
POSTGRES_DB=apiforge
POSTGRES_PASSWORD=
